# --- Default di Composer ---
composer.phar
/vendor/
composer.lock

# --- Sicurezza StartupFlow ---
# Ignora le credenziali di database
config.php
.env

# --- Database ---
# Ignora i dump (es. backup.sql), ma manteniamo lo schema ufficiale
*.sql
!database/schema.sql

# Ignora documenti sensibili (Modulo Zero Carta & Spese)
/uploads*
# MA permette ai file .gitkeep di essere tracciati (mantiene la struttura delle cartelle vuote su Github)
!/uploads/documenti/.gitkeep
!/uploads/scontrini/.gitkeep

# Ignora file temporanei e di sistema
*.log
*.sql
.DS_Store
Thumbs.db
.idea/
.vscode/
